# Copy to .env, edit, then load it in your shell before starting the server.
STUDIO_PORT=8765
# Optional, one-time VoiceStudio profile migration only.
STUDIO_VOICE_URL=http://127.0.0.1:3900
# Directory containing ltx-2.3-q4/ and optionally huggingface/.
STUDIO_MODELS_DIR=/absolute/path/to/models
STUDIO_LTX_BIN=/absolute/path/to/ltx-2-mlx
STUDIO_MUSE_PYTHON=/absolute/path/to/musetalk-venv/bin/python
STUDIO_MUSETALK_ROOT=/absolute/path/to/MuseTalk
# Optional: Python interpreter with OpenCV for the face check (timeline option).
STUDIO_CV_PYTHON=python3
# Optional: directory containing ffmpeg for the LTX subprocess.
STUDIO_FFMPEG_BIN=
# Optional: avatar creation (FLUX). Folder holding mflux-generate-flux2[-edit] / -flux3[-edit].
STUDIO_MFLUX_BIN=
# Optional: weights already installed elsewhere (flux2/klein-4b, flux3/klein-mlx-8bit inside).
STUDIO_IMAGE_MODELS_DIR=

# Optional: independent MLX speech interpreter (default .venv-voix/bin/python).
# STUDIO_TTS_PYTHON=/absolute/path/to/tts-venv/bin/python
